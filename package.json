{
  "name": "qr-studio-pro",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run typecheck && npm run build && npm run check:build",
    "test:offline": "node scripts/offline-test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dexie": "^4.4.7",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "description": "QR Studio Pro — offline-first PWA to create, design, save, export and scan QR codes."
}
